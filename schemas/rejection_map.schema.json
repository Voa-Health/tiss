{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mapa de rejeição",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versao",
    "lotes",
    "guias",
    "ignorados",
    "prestadores",
    "linhas"
  ],
  "properties": {
    "versao": {
      "const": "1"
    },
    "lotes": {
      "type": "integer",
      "minimum": 0
    },
    "guias": {
      "type": "integer",
      "minimum": 0
    },
    "ignorados": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "prestadores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prestador",
          "mes",
          "guias",
          "guias_com_achado",
          "valor_total",
          "valor_afetado"
        ],
        "properties": {
          "prestador": {
            "type": "string",
            "pattern": "^(codigo:.+|cnpj:\\d{14}|cpf:hmac:[0-9a-f]{64})$"
          },
          "mes": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}$"
          },
          "guias": {
            "type": "integer",
            "minimum": 0
          },
          "guias_com_achado": {
            "type": "integer",
            "minimum": 0
          },
          "valor_total": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$"
          },
          "valor_afetado": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$"
          }
        }
      }
    },
    "linhas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prestador",
          "mes",
          "codigo",
          "glosa",
          "rule_id",
          "guias",
          "valor_afetado"
        ],
        "properties": {
          "prestador": {
            "type": "string",
            "pattern": "^(codigo:.+|cnpj:\\d{14}|cpf:hmac:[0-9a-f]{64})$"
          },
          "mes": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}$"
          },
          "codigo": {
            "type": "string"
          },
          "glosa": {
            "type": [
              "string",
              "null"
            ]
          },
          "rule_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "guias": {
            "type": "integer",
            "minimum": 0
          },
          "valor_afetado": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$"
          }
        }
      }
    }
  }
}
