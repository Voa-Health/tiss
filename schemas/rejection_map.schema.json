{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mapa de rejeição",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "lotes",
    "guias",
    "ignored",
    "providers",
    "rows"
  ],
  "properties": {
    "version": {
      "const": "2"
    },
    "lotes": {
      "type": "integer",
      "minimum": 0
    },
    "guias": {
      "type": "integer",
      "minimum": 0
    },
    "ignored": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "month",
          "guias",
          "guias_with_finding",
          "total_amount",
          "affected_amount"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "pattern": "^(codigo:.+|cnpj:\\d{14}|cpf:hmac:[0-9a-f]{64})$"
          },
          "month": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}$"
          },
          "guias": {
            "type": "integer",
            "minimum": 0
          },
          "guias_with_finding": {
            "type": "integer",
            "minimum": 0
          },
          "total_amount": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$"
          },
          "affected_amount": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$"
          }
        }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "month",
          "code",
          "glosa",
          "rule_id",
          "guias",
          "affected_amount"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "pattern": "^(codigo:.+|cnpj:\\d{14}|cpf:hmac:[0-9a-f]{64})$"
          },
          "month": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}$"
          },
          "code": {
            "type": "string"
          },
          "glosa": {
            "type": [
              "string",
              "null"
            ]
          },
          "rule_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "guias": {
            "type": "integer",
            "minimum": 0
          },
          "affected_amount": {
            "type": "string",
            "pattern": "^-?\\d+\\.\\d{2}$"
          }
        }
      }
    }
  }
}
